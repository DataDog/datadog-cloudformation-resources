{
  "Type": "query alert",
  "Query": "avg(current_1mo):avg:aws.ec2.cpu{environment:foo,host:foo} by {host,environment} > 4",
  "Name": "SSH Activity on PROD",
  "Message": "@slack-datadog-testing",
  "Priority": 1,
  "Options": {
    "Locked": false,
    "IncludeTags": true,
    "NewHostDelay": 300,
    "NotifyAudit": false,
    "NotifyBy": ["host"],
    "NotificationPresetName":"show_all",
    "NotifyNoData": false,
    "RenotifyInterval": 0,
    "EnableLogsSample": true,
    "SchedulingOptions": {
      "EvaluationWindow": {
        "DayStarts": "22:00",
        "MonthStarts":1,
        "Timezone": "America/New_York"
      }
    },
    "Thresholds": {
      "Critical": 4
    }
  },
  "Assets": [
    {
      "Category": "runbook",
      "Name": "Datadog Runbook",
      "Url": "/notebook/1234",
      "ResourceType": "notebook",
      "ResourceKey": "1234"
    },
    {
      "Category": "runbook",
      "Name": "External Runbook",
      "Url": "https://example.com/runbooks/ssh-activity"
    }
  ]
}