{
  "Type": "rum alert",
  "Query": "rum(\"*\").rollup(\"count\").last(\"5m\") > 5000000",
  "Name": "RUM Monitoring on PROD updated",
  "Message": "@slack-datadog-testing",
  "Priority": 1,
  "Options": {
    "Locked": false,
    "IncludeTags": false,
    "NewHostDelay": 40,
    "NotifyAudit": true,
    "NotifyNoData": true,
    "RenotifyInterval": 5,
    "Thresholds": {
      "Critical": 5000000
    }
  },
  "Assets": [
    {
      "Category": "runbook",
      "Name": "RUM Runbook updated",
      "Url": "https://example.com/runbooks/rum-traffic-updated"
    },
    {
      "Category": "runbook",
      "Name": "RUM Notebook Runbook",
      "Url": "/notebook/1234",
      "ResourceType": "notebook",
      "ResourceKey": "1234"
    }
  ]
}
